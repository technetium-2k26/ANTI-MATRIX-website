# Application Core
FLASK_APP=app.py
FLASK_ENV=production
FLASK_CONFIG=production
SECRET_KEY=generate-a-strong-random-secret-key-here
PORT=5000

# Database Configuration (SQLite default, or PostgreSQL URL)
DATABASE_URL=sqlite:///antimatrix.db
# DATABASE_URL=postgresql://username:password@localhost:5432/antimatrix_db

# Admin User Defaults
ADMIN_EMAIL=admin@antimatrix.ai
ADMIN_PASSWORD=Admin@AntiMatrix2026!

# Cashfree Payment Gateway Configuration
# Use 'sandbox' for testing, 'production' for live payments
CASHFREE_ENVIRONMENT=sandbox
CASHFREE_CLIENT_ID=your_cashfree_app_id_here
CASHFREE_CLIENT_SECRET=your_cashfree_secret_key_here
CASHFREE_API_VERSION=2023-08-01
CASHFREE_RETURN_URL=http://127.0.0.1:5000/payment/cashfree/return
CASHFREE_WEBHOOK_URL=http://127.0.0.1:5000/payment/cashfree/webhook

# TEMPORARY DEVELOPMENT PAYMENT MODE
# Set to true ONLY for local/testing environments to bypass Cashfree checkout.
# MUST be false in production.
PAYMENT_TEST_MODE=false

# Email / Contact Inquiries (Optional)
CONTACT_EMAIL=contact@anti-matrix.com
CAREERS_EMAIL=careers@anti-matrix.com

