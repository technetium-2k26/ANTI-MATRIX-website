# Application Core
FLASK_APP=app.py
FLASK_ENV=production
FLASK_CONFIG=production
SECRET_KEY=generate-a-strong-random-secret-key-here
PORT=5000

# Database Configuration (SQLite default, or Supabase PostgreSQL URL)
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
# DATABASE_URL=sqlite:///antimatrix.db

# Admin User Defaults
ADMIN_EMAIL=admin@antimatrix.ai
ADMIN_PASSWORD=Admin@AntiMatrix2026!

# Cashfree Payment Gateway Configuration (SANDBOX ENVIRONMENT)
# Expected Render configuration for Cashfree Sandbox:
CASHFREE_ENV=sandbox
CASHFREE_APP_ID=your_cashfree_sandbox_app_id_here
CASHFREE_SECRET_KEY=your_cashfree_sandbox_secret_key_here
# Backward-compatible aliases:
# CASHFREE_ENVIRONMENT=sandbox
# CASHFREE_CLIENT_ID=your_cashfree_sandbox_app_id_here
# CASHFREE_CLIENT_SECRET=your_cashfree_sandbox_secret_key_here
CASHFREE_API_VERSION=2025-01-01
CASHFREE_RETURN_URL=http://127.0.0.1:5000/payment/cashfree/return
CASHFREE_WEBHOOK_URL=http://127.0.0.1:5000/payment/cashfree/webhook

# TEMPORARY DEVELOPMENT PAYMENT MODE
# Set to true ONLY for local/testing environments to bypass Cashfree checkout.
# MUST be false in production.
PAYMENT_TEST_MODE=false

# Brevo (Sendinblue) Email Service Configuration
# Get your API key from: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=xkeysib-your-brevo-v3-api-key-here
BREVO_SENDER_EMAIL=info@antimatrix.co.in
BREVO_SENDER_NAME=Anti Matrix

# SMTP Fallback Configuration (Optional if Brevo API Key is set)
# SMTP_SERVER=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your_smtp_login
# SMTP_PASSWORD=your_smtp_key
# SENDER_EMAIL=info@antimatrix.co.in

# Email / Contact Inquiries (Optional)
CONTACT_EMAIL=contact@anti-matrix.com
CAREERS_EMAIL=careers@anti-matrix.com

# Public Application Base URL (for local vs production OAuth redirects)
# In local development: http://localhost:5000 or http://127.0.0.1:5000
# In production on Render/Custom Domain: https://yourdomain.com
APP_URL=http://localhost:5000

# Google OAuth 2.0 Configuration
# Create credentials in Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
# Authorized redirect URIs: http://localhost:5000/auth/google/callback (local) & https://yourdomain.com/auth/google/callback (prod)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/auth/google/callback

# GitHub OAuth App Configuration
# Create app in GitHub -> Settings -> Developer settings -> OAuth Apps -> New OAuth App
# Homepage URL: http://localhost:5000
# Authorization callback URL: http://localhost:5000/auth/github/callback
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URI=http://localhost:5000/auth/github/callback
